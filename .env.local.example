ANTHROPIC_API_KEY=sk-ant-...

# Supabase — from your project's Settings → API.
# Both of these are safe to expose to the browser (the anon key is public,
# protected by row-level security).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...

# Server-only. Used ONLY by the ingestion route (/api/ingest) to write the
# global `opportunities` table, which RLS otherwise blocks. This key bypasses
# RLS — never prefix it with NEXT_PUBLIC_, never expose it to the browser, and
# never commit it. Add it in Vercel as a (non-public) Environment Variable.
SUPABASE_SERVICE_ROLE_KEY=ey...

# Shared secret protecting the cron ingestion endpoint. Generate any random
# string. Vercel Cron sends it automatically; set the same value in Vercel.
CRON_SECRET=
